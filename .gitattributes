# General setting: Let Git handle line endings automatically for all other text files.
* text=auto

# Store screenshots, app previews and the Affinity source live in Git LFS.
assets/store/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/store/**/*.af filter=lfs diff=lfs merge=lfs -text
assets/store/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
