# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Alchemist platform goldens are intentionally local-only. The portable
# text-obscured baselines under goldens/ci remain tracked.
**/goldens/macos/
**/goldens/linux/
**/goldens/windows/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configuration
android/app/google-services.json
android/app/src/dev/google-services.json
android/app/src/prod/google-services.json

ios/Runner/GoogleService-Info.plist
ios/Runner/Firebase/Dev/GoogleService-Info.plist
ios/Runner/Firebase/Prod/GoogleService-Info.plist

# Google Cloud Console
ios/Runner/client_*.plist

# Mapbox Secret Access Token
.env

.mcp.json
.claude/scheduled_tasks.lock

# Marketing: store metrics stay private; music licenses forbid redistribution
docs/marketing/metrics/
tool/marketing/assets/music/
tool/marketing/assets/voice/**/*.mp3

# Custom product page media: copies of the default set, generated from media_order.txt
docs/store/app-store/custom-product-pages/*/*/screenshots/
docs/store/app-store/custom-product-pages/*/*/app_previews/

# Affinity lock files while a document is open
*.af~lock~

# Store upload credentials
*.p8
fastlane/.env
fastlane/report.xml
fastlane/README.md

# Knob research: reference photos and source notes stay local; the README and inventory are tracked
data/knob_research/**
!data/knob_research/README.md
!data/knob_research/inventory.yaml
