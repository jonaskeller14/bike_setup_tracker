{
    // Keyboard Shortcut: Strg + Shift + B
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Codex: gc",
            "type": "shell",
            "command": "codex",
            "args": [
                "exec",
                "--cd",
                "${workspaceFolder}",
                "--model",
                "gpt-5.6-luna",
                "--sandbox",
                "workspace-write",
                "Use .agents/skills/gc-fast/SKILL.md. Commit the currently staged changes and follow those instructions exactly."
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Claude: gc",
            "type": "shell",
            "command": "claude",
            "args": [
                "--model",
                "haiku",
                "/gc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build & Install APK (Debug) [R3CX50CQWVA]",
            "type": "shell",
            "command": "flutter build apk --debug; if ($LASTEXITCODE -eq 0) { adb -s R3CX50CQWVA install build\\app\\outputs\\flutter-apk\\app-debug.apk } else { exit $LASTEXITCODE }",
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Build & Install APK (Release) [R3CX50CQWVA]",
            "type": "shell",
            "command": "flutter build apk --release; if ($LASTEXITCODE -eq 0) { adb -s R3CX50CQWVA install build\\app\\outputs\\flutter-apk\\app-release.apk } else { exit $LASTEXITCODE }",
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Firebase: Deploy Functions (Strava Backend)",
            "type": "shell",
            "command": "firebase deploy --only functions",
            "options": {
                "cwd": "${workspaceFolder}/backend_strava"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Firebase: Deploy All (Rules & Functions)",
            "type": "shell",
            "command": "firebase deploy",
            "options": {
                "cwd": "${workspaceFolder}/backend_strava"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Runner: Generate .g Files (Drift, Envied)",
            "type": "shell",
            "command": "flutter pub run build_runner build",
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
