<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The launcher long-press "Add New Setup" entry is registered at runtime
        by QuickActionsService (lib/services/quick_actions_service.dart) so it
        works on both Android and iOS; no static action shortcut is defined
        here to avoid a duplicate launcher entry.

        Inline inventory (entity shortcuts) for the CREATE BII.
        No <intent>, no labels, no icon → not shown in the launcher and
        accepted by the Play Console actions-schema parser without
        shortcutShortLabel. Matching constrains object.type to the listed
        synonyms; the matched shortcutId is then substituted into the
        capability intent's URL template below.
    -->
    <shortcut android:shortcutId="setup">
        <capability-binding android:key="actions.intent.CREATE_CREATE_TYPE_NAME">
            <parameter-binding android:key="object.type" android:value="@array/type_setup" />
        </capability-binding>
    </shortcut>

    <shortcut android:shortcutId="bike">
        <capability-binding android:key="actions.intent.CREATE_CREATE_TYPE_NAME">
            <parameter-binding android:key="object.type" android:value="@array/type_bike" />
        </capability-binding>
    </shortcut>

    <shortcut android:shortcutId="component">
        <capability-binding android:key="actions.intent.CREATE_CREATE_TYPE_NAME">
            <parameter-binding android:key="object.type" android:value="@array/type_component" />
        </capability-binding>
    </shortcut>

    <!--
        Capability routes to bike-setup-tracker://add?type={shortcutId}
        based on which entity shortcut matched.
    -->
    <capability android:name="actions.intent.CREATE_CREATE_TYPE_NAME">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jonaskeller14.bike_setup_tracker"
            android:targetClass="com.jonaskeller14.bike_setup_tracker.MainActivity">
            <url-template android:value="bike-setup-tracker://add{?type}" />
            <parameter android:name="object.type" android:key="type" />
        </intent>
    </capability>

    <!-- Assistant-only: "add a task" — separate BII, no launcher entry needed -->
    <capability android:name="actions.intent.CREATE_TASK">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jonaskeller14.bike_setup_tracker"
            android:targetClass="com.jonaskeller14.bike_setup_tracker.MainActivity"
            android:data="bike-setup-tracker://add-task" />
    </capability>

</shortcuts>
