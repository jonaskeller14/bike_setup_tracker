rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isLinkedToAthlete(athleteId) {
      return request.auth != null
        && athleteId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linked_athletes;
    }

    // `users/{userId}` — per-device, anonymous.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly([
                      'fcm_token',
                      'expiresAt',
                      'enable_strava_notifications'
                    ]);

      // Client may update device fields and remove athletes (disconnect).
      // Entitlement and adding a new athlete are server-only.
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'fcm_token',
                      'expiresAt',
                      'enable_strava_notifications',
                      'linked_athletes'
                    ])
                    && (
                      !('linked_athletes' in request.resource.data.diff(resource.data).affectedKeys())
                      || request.resource.data.linked_athletes.size() < resource.data.linked_athletes.size()
                    );

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // `athletes/{athleteId}` — canonical Strava-side data.
    //
    // Root doc (profile: firstname, lastname, photo, sync state):
    //   Strict — requires a get() to verify the device is linked. One read
    //   per session open, infrequent.
    //
    // Subcollections (activity_batches, gears):
    //   Relaxed to auth-only — no extra get() per document. Activity stats
    //   and gear IDs are the same data Strava exposes publicly on any
    //   athlete's profile page; the sensitive OAuth tokens live in
    //   `athlete_oauth` (server-only). This halves subcollection read costs.
    match /athletes/{athleteId} {
      allow read:  if isLinkedToAthlete(athleteId);
      allow write: if false;

      match /activity_batches/{batchId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // `athlete_oauth/{athleteId}` — Strava tokens. Server-only.
    match /athlete_oauth/{athleteId} {
      allow read, write: if false;
    }

    // Short-lived OAuth state records map random state to a UID. Server-only.
    match /strava_oauth_states/{state} {
      allow read, write: if false;
    }

    // `server_config/strava_limits` — read-only availability config.
    match /server_config/{doc} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
