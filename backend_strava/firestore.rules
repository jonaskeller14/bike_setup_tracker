rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // `users/{userId}` is per-device, anonymous. Holds the link to one or
    // more athletes, the subscription entitlement, FCM token, and per-device
    // notification prefs.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Client can create with the per-device fields it owns. Entitlement
      // and linked_athletes are server-managed.
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly([
                      'fcm_token',
                      'expiresAt',
                      'enable_strava_notifications'
                    ]);

      // Client can update its own per-device fields and remove an athlete
      // from its own link list (disconnect flow). Entitlement and adding a
      // new athlete are server-only — those go through Cloud Functions.
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'fcm_token',
                      'expiresAt',
                      'enable_strava_notifications',
                      'linked_athletes'
                    ])
                    && (
                      // Allow only removals from linked_athletes from the
                      // client. Additions only happen via the OAuth callback
                      // (Cloud Function, bypasses these rules).
                      !('linked_athletes' in request.resource.data.diff(resource.data).affectedKeys())
                      || request.resource.data.linked_athletes.size() < resource.data.linked_athletes.size()
                    );

      // No nested subcollections on users anymore.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // `athletes/{athleteId}` is the canonical Strava-side data. Profile,
    // sync state, OAuth tokens, plus subcollections for activity batches and
    // gear. Client-reachable for read only, and only if this device has
    // linked the athlete.
    match /athletes/{athleteId} {
      allow read: if request.auth != null
                  && athleteId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linked_athletes;
      allow write: if false; // server-only

      match /{subcollection=**} {
        allow read: if request.auth != null
                    && athleteId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linked_athletes;
        allow write: if false;
      }
    }

    // `athlete_oauth/{athleteId}` — Strava OAuth tokens. Server-only, never
    // reachable from a client.
    match /athlete_oauth/{athleteId} {
      allow read, write: if false;
    }

    // `server_config/strava_limits` — read-only public config doc used by
    // availability check. Written manually in Firebase Console.
    match /server_config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
