  "faqGeneralAboutQuestion": "What is this app about?",
  "@faqGeneralAboutQuestion": {
    "description": "Question of the FAQ entry \"GeneralAbout\"."
  },
  "faqGeneralAboutAnswer": "This app helps you track, manage, and optimize your bike setup adjustments for better performance.",
  "@faqGeneralAboutAnswer": {
    "description": "Answer of the FAQ entry \"GeneralAbout\"."
  },
  "faqGeneralExportQuestion": "Can I export or share my data?",
  "@faqGeneralExportQuestion": {
    "description": "Question of the FAQ entry \"GeneralExport\"."
  },
  "faqGeneralExportAnswer": "Yes. Use \"Export\" to save your entire database as a JSON file. You choose where to save it in your device’s file picker. This file is intended for backups and can be reimported later. \n\nUse \"Share\" to send a snapshot of your data directly to another app (like Mail, Cloud, or Messenger). You can choose between multiple formats: JSON (reimportable), Excel, CSV, or plain text.",
  "@faqGeneralExportAnswer": {
    "description": "Answer of the FAQ entry \"GeneralExport\"."
  },
  "faqGeneralLocalQuestion": "Is my data stored locally?",
  "@faqGeneralLocalQuestion": {
    "description": "Question of the FAQ entry \"GeneralLocal\"."
  },
  "faqGeneralLocalAnswer": "Yes, all your data is stored locally on your device. We do not collect or store any of your personal information.",
  "@faqGeneralLocalAnswer": {
    "description": "Answer of the FAQ entry \"GeneralLocal\"."
  },
  "faqGeneralRecoverQuestion": "I accidentally deleted something. Can I recover it?",
  "@faqGeneralRecoverQuestion": {
    "description": "Question of the FAQ entry \"GeneralRecover\"."
  },
  "faqGeneralRecoverAnswer": "Yes. Open the menu in the top-right corner of the home page and select \"Trash.\" You can restore items deleted within the last 30 days. After 30 days, items are permanently deleted.",
  "@faqGeneralRecoverAnswer": {
    "description": "Answer of the FAQ entry \"GeneralRecover\"."
  },
  "faqGeneralMoveQuestion": "How do I move my data to a new device?",
  "@faqGeneralMoveQuestion": {
    "description": "Question of the FAQ entry \"GeneralMove\"."
  },
  "faqGeneralMoveAnswer": "Data is typically restored by your operating system if you have cloud backups enabled. To move data manually: Export your data as a JSON file from the home page menu, transfer that file to your new device (via cloud or cable), and select \"Import\" from the menu on the new device.",
  "@faqGeneralMoveAnswer": {
    "description": "Answer of the FAQ entry \"GeneralMove\"."
  },
  "faqBikesAddQuestion": "How do I add a new bike?",
  "@faqBikesAddQuestion": {
    "description": "Question of the FAQ entry \"BikesAdd\"."
  },
  "faqBikesAddAnswer": "Tap the \"+\" button in the \"Bikes\" tab to create a new bike.",
  "@faqBikesAddAnswer": {
    "description": "Answer of the FAQ entry \"BikesAdd\"."
  },
  "faqBikesComponentsQuestion": "Where are my components?",
  "@faqBikesComponentsQuestion": {
    "description": "Question of the FAQ entry \"BikesComponents\"."
  },
  "faqBikesComponentsAnswer": "Components are listed directly under the bike they are installed on. Tap a component to see its details and make adjustments.",
  "@faqBikesComponentsAnswer": {
    "description": "Answer of the FAQ entry \"BikesComponents\"."
  },
  "faqBikesEditDeleteQuestion": "How do I edit or delete a component?",
  "@faqBikesEditDeleteQuestion": {
    "description": "Question of the FAQ entry \"BikesEditDelete\"."
  },
  "faqBikesEditDeleteAnswer": "Tap on a component to open its detailed view, then tap the three-dot menu in the top-right corner to edit, duplicate, or delete it.",
  "@faqBikesEditDeleteAnswer": {
    "description": "Answer of the FAQ entry \"BikesEditDelete\"."
  },
  "faqBikesMoveComponentQuestion": "How do I move a component to a different bike?",
  "@faqBikesMoveComponentQuestion": {
    "description": "Question of the FAQ entry \"BikesMoveComponent\"."
  },
  "faqBikesMoveComponentAnswer": "Long-press a component and drag it onto the card of the bike you want to move it to.",
  "@faqBikesMoveComponentAnswer": {
    "description": "Answer of the FAQ entry \"BikesMoveComponent\"."
  },
  "faqBikesReorderComponentsQuestion": "How do I reorder my components?",
  "@faqBikesReorderComponentsQuestion": {
    "description": "Question of the FAQ entry \"BikesReorderComponents\"."
  },
  "faqBikesReorderComponentsAnswer": "Long-press and drag a component icon to change its position within a bike or list.",
  "@faqBikesReorderComponentsAnswer": {
    "description": "Answer of the FAQ entry \"BikesReorderComponents\"."
  },
  "faqBikesUninstalledQuestion": "What is the \"Uninstalled\" section?",
  "@faqBikesUninstalledQuestion": {
    "description": "Question of the FAQ entry \"BikesUninstalled\"."
  },
  "faqBikesUninstalledAnswer": "This section at the bottom of the \"Bikes\" tab lists components that are currently not assigned to any bike. You can drag them from here onto a bike to install them.",
  "@faqBikesUninstalledAnswer": {
    "description": "Answer of the FAQ entry \"BikesUninstalled\"."
  },
  "faqBikesUninstalledVsArchivedQuestion": "What is the difference between \"Uninstalled\" and \"Archived\"?",
  "@faqBikesUninstalledVsArchivedQuestion": {
    "description": "Question of the FAQ entry \"BikesUninstalledVsArchived\"."
  },
  "faqBikesUninstalledVsArchivedAnswer": "Both states mean a component is off the bike, but they serve different purposes.\n\n\"Uninstalled\" means the component is off the bike but still usable. It stays visible in the Uninstalled section and can be reinstalled at any time — for example, a spare wheelset you swap in for race day, or a saddle you temporarily moved to another bike.\n\n\"Archived\" means the component is retired and will never be used again. It is hidden from the main view to keep your garage clean, but all its history and statistics are preserved. Use this for worn-out brake pads or tires, broken or sold parts, or anything you no longer ride. You can still find archived components in the Archived section and restore them if needed.",
  "@faqBikesUninstalledVsArchivedAnswer": {
    "description": "Answer of the FAQ entry \"BikesUninstalledVsArchived\"."
  },
  "faqAdjustmentWhatQuestion": "What is an \"Adjustment\"?",
  "@faqAdjustmentWhatQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentWhat\"."
  },
  "faqAdjustmentWhatAnswer": "An Adjustment defines a specific part of a component that can be modified (e.g., tire pressure or suspension rebound). It sets the rules — the type, the unit, and the allowed range — while the actual values are recorded within a \"Setup.\"",
  "@faqAdjustmentWhatAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentWhat\"."
  },
  "faqAdjustmentTypesQuestion": "Which adjustment types can I choose from?",
  "@faqAdjustmentTypesQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentTypes\"."
  },
  "faqAdjustmentTypesAnswer": "Numerical for measured values with a unit (e.g. 22.5 psi), Step for click-based dials (e.g. rebound 8 of 15), Categorical for a fixed list of options, and On/Off for things like a lockout. Text, for free-form entries, appears once you enable it under Settings → Features → Text Adjustment.\n\nYou pick the type when adding the adjustment — it decides how you enter values in a Setup later. Above the types, the \"Add Adjustment\" sheet also suggests ready-made templates for the component you are on, which are the quickest way to get started.",
  "@faqAdjustmentTypesAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentTypes\"."
  },
  "faqAdjustmentOtherUnitQuestion": "Can I read or enter a value in a different unit?",
  "@faqAdjustmentOtherUnitQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentOtherUnit\"."
  },
  "faqAdjustmentOtherUnitAnswer": "Yes — tap the unit label next to the value (the small \"psi\", \"bar\", \"mm\" … text). Each tap cycles to the next compatible unit and converts the number for you. This works both when reading a setup and when typing a value into one. While a converted unit is active, a small line shows what the value is in the unit the adjustment is actually stored in.\n\nThis only changes what you see: the adjustment and the stored value stay untouched, and the display resets when you leave the page. To change the unit permanently, edit the adjustment.",
  "@faqAdjustmentOtherUnitAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentOtherUnit\"."
  },
  "faqAdjustmentSagQuestion": "What is \"SAG\"?",
  "@faqAdjustmentSagQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentSag\"."
  },
  "faqAdjustmentSagAnswer": "SAG is not a type of its own — it is a special flavour of the Numerical adjustment, made for suspension sag. It is always stored as a percentage between 0 and 100 %.\n\nWhat it adds is the reference travel: fill in the \"Fork Travel\" or \"Shock Stroke\" of the component and the app can convert that percentage into an absolute length. Tap the unit label on the value to cycle % → mm → in. That way you can measure sag with a ruler on the stanchion or shock shaft and let the app do the math — in either direction.",
  "@faqAdjustmentSagAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentSag\"."
  },
  "faqAdjustmentSagAddQuestion": "How do I add a SAG adjustment?",
  "@faqAdjustmentSagAddQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentSagAdd\"."
  },
  "faqAdjustmentSagAddAnswer": "You will not find SAG in the list of adjustment types. Add it from the \"SAG\" template that the \"Add Adjustment\" sheet suggests for a fork or a shock, then enter the travel or stroke.\n\nIf you already track sag as a plain numerical adjustment in %, you do not have to start over: edit it, and as long as its name contains \"sag\" and its unit is %, a \"Convert to SAG adjustment\" banner appears. All recorded values and the full history stay attached, and it is reversible — on a SAG adjustment, use the three-dot menu → \"Convert to plain numerical\".",
  "@faqAdjustmentSagAddAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentSagAdd\"."
  },
  "faqAdjustmentChangeUnitQuestion": "What happens to my recorded values if I change an adjustment’s unit?",
  "@faqAdjustmentChangeUnitQuestion": {
    "description": "Question of the FAQ entry \"AdjustmentChangeUnit\"."
  },
  "faqAdjustmentChangeUnitAnswer": "If no setup has a value recorded for the adjustment, nothing happens. Otherwise a sheet shows how many setups are affected, including deleted ones, with an example. If the old and the new unit measure the same thing (e.g. bar → psi), you choose:\n\n\"Convert values\" recalculates every previously recorded value into the new unit (10 bar becomes 145 psi). Use this when your old values were correct and you just want to read them differently.\n\n\"Keep numbers\" leaves the numbers untouched and only relabels them (10 bar becomes 10 psi). Use this when the values had been recorded in the wrong unit all along.\n\nIf the units are not compatible (e.g. psi → mm), no conversion is possible: you can keep the numbers, which are then read in the new unit, or clear the recorded values. Min and max are always kept exactly as you typed them.",
  "@faqAdjustmentChangeUnitAnswer": {
    "description": "Answer of the FAQ entry \"AdjustmentChangeUnit\"."
  },
  "faqBikesReorderBikesQuestion": "How do I reorder my bikes?",
  "@faqBikesReorderBikesQuestion": {
    "description": "Question of the FAQ entry \"BikesReorderBikes\"."
  },
  "faqBikesReorderBikesAnswer": "Long-press and drag a bike card to move it up or down in the list.",
  "@faqBikesReorderBikesAnswer": {
    "description": "Answer of the FAQ entry \"BikesReorderBikes\"."
  },
  "faqSetupWhatQuestion": "What is a \"Setup\"?",
  "@faqSetupWhatQuestion": {
    "description": "Question of the FAQ entry \"SetupWhat\"."
  },
  "faqSetupWhatAnswer": "A Setup is a snapshot of your entire bike configuration. It captures the specific values of all your adjustments alongside context like location, weather, and trail conditions.",
  "@faqSetupWhatAnswer": {
    "description": "Answer of the FAQ entry \"SetupWhat\"."
  },
  "faqSetupRecordQuestion": "How do I record a new setup?",
  "@faqSetupRecordQuestion": {
    "description": "Question of the FAQ entry \"SetupRecord\"."
  },
  "faqSetupRecordAnswer": "Go to the \"Setups\" tab and tap the \"+\" button to record a new setup for your bike.",
  "@faqSetupRecordAnswer": {
    "description": "Answer of the FAQ entry \"SetupRecord\"."
  },
  "faqSetupHighlightsQuestion": "What do the green and orange highlights on a value mean?",
  "@faqSetupHighlightsQuestion": {
    "description": "Question of the FAQ entry \"SetupHighlights\"."
  },
  "faqSetupHighlightsAnswer": "They show how a value compares to the setup you last recorded.\n\nGreen means the value is recorded for the first time — there was no earlier value to compare it to.\n\nOrange means you changed the value: the previous one is shown underneath, crossed out, so you can see at a glance what you actually touched.",
  "@faqSetupHighlightsAnswer": {
    "description": "Answer of the FAQ entry \"SetupHighlights\"."
  },
  "faqSetupRestoreIconQuestion": "What does the ↺ icon next to a value do?",
  "@faqSetupRestoreIconQuestion": {
    "description": "Question of the FAQ entry \"SetupRestoreIcon\"."
  },
  "faqSetupRestoreIconAnswer": "It restores the value the adjustment had when you opened the setup — usually the one carried over from your last setup. Use it to undo a change you are not happy with, without leaving the page.",
  "@faqSetupRestoreIconAnswer": {
    "description": "Answer of the FAQ entry \"SetupRestoreIcon\"."
  },
  "faqSetupOtherUnitQuestion": "Can I enter a value in a different unit than the adjustment uses?",
  "@faqSetupOtherUnitQuestion": {
    "description": "Question of the FAQ entry \"SetupOtherUnit\"."
  },
  "faqSetupOtherUnitAnswer": "Yes. Tap the unit label next to the input field to cycle through the compatible units — type in whichever one you measured in, and the app converts and stores it in the adjustment’s own unit. A small line below the field shows the value as it will be stored. See the Adjustment questions above for the full details.",
  "@faqSetupOtherUnitAnswer": {
    "description": "Answer of the FAQ entry \"SetupOtherUnit\"."
  },
  "faqSetupLocationLaterQuestion": "I recorded a setup without GPS. Can I add the location later?",
  "@faqSetupLocationLaterQuestion": {
    "description": "Question of the FAQ entry \"SetupLocationLater\"."
  },
  "faqSetupLocationLaterAnswer": "Yes. Edit the setup, tap the location chip (showing a pin or \"Location Context\"), and use the search bar in the sheet to find the address. Alternatively, you can manually enter the Latitude and Longitude.",
  "@faqSetupLocationLaterAnswer": {
    "description": "Answer of the FAQ entry \"SetupLocationLater\"."
  },
  "faqSetupOfflineQuestion": "I recorded a setup without Internet. How do I update address and weather?",
  "@faqSetupOfflineQuestion": {
    "description": "Question of the FAQ entry \"SetupOffline\"."
  },
  "faqSetupOfflineAnswer": "Edit the setup and open the location sheet (tap the location chip) to manually fetch the address from Latitude and Longitude. Then, open the weather sheet (tap the weather chip) and tap \"Update Weather by Location\".",
  "@faqSetupOfflineAnswer": {
    "description": "Answer of the FAQ entry \"SetupOffline\"."
  },
  "faqSetupRawDataQuestion": "Can I see a raw data overview of all my setups?",
  "@faqSetupRawDataQuestion": {
    "description": "Question of the FAQ entry \"SetupRawData\"."
  },
  "faqSetupRawDataAnswer": "Yes. Open the detailed view of a component (by tapping its icon in \"Bikes\" tab) and then tap on the large card representing the component. This opens a table view where you can compare setups, select which columns to show, and sort the data for deeper analysis.",
  "@faqSetupRawDataAnswer": {
    "description": "Answer of the FAQ entry \"SetupRawData\"."
  },
  "faqSetupRestoreQuestion": "What does the \"Restore\" option do?",
  "@faqSetupRestoreQuestion": {
    "description": "Question of the FAQ entry \"SetupRestore\"."
  },
  "faqSetupRestoreAnswer": "It duplicates the selected setup, copying all adjustment values, but sets the date and time to now. It also automatically updates the location and weather to your current position. \n\nThis is especially useful if you made changes that feel worse than before and want to easily go back to a previous, known good setup.",
  "@faqSetupRestoreAnswer": {
    "description": "Answer of the FAQ entry \"SetupRestore\"."
  },
  "faqRiderWhyQuestion": "Why?",
  "@faqRiderWhyQuestion": {
    "description": "Question of the FAQ entry \"RiderWhy\"."
  },
  "faqRiderWhyAnswer": "Your rider profile adds personal context to your setups. Values like your riding weight directly influence how bike components behave, so recording them with each setup makes finding the optimal setup easier.",
  "@faqRiderWhyAnswer": {
    "description": "Answer of the FAQ entry \"RiderWhy\"."
  },
  "faqRiderAddQuestion": "How to add a Rider?",
  "@faqRiderAddQuestion": {
    "description": "Question of the FAQ entry \"RiderAdd\"."
  },
  "faqRiderAddAnswer": "Tap the rider icon in the top bar and enter your name. You can also create your rider from the rider tab while adding a setup.",
  "@faqRiderAddAnswer": {
    "description": "Answer of the FAQ entry \"RiderAdd\"."
  },
  "faqRiderLinkQuestion": "How to link a Rider to a Bike?",
  "@faqRiderLinkQuestion": {
    "description": "Question of the FAQ entry \"RiderLink\"."
  },
  "faqRiderLinkAnswer": "Navigate to the \"Bikes\" tab and select the bike you want to link. Tap the three-dot menu, select \"Edit\", and choose the rider from the \"Rider\" dropdown menu. Alternatively, tap \"Link rider\" in the rider tab while adding a setup for that bike. A bike can also have no rider, e.g. a bike of a family member.",
  "@faqRiderLinkAnswer": {
    "description": "Answer of the FAQ entry \"RiderLink\"."
  },
  "faqRiderWeightQuestion": "How do I update my riding weight?",
  "@faqRiderWeightQuestion": {
    "description": "Question of the FAQ entry \"RiderWeight\"."
  },
  "faqRiderWeightAnswer": "Rider values are recorded with each setup: add a setup and enter the current values in its rider tab. To add, rename or remove attributes, tap the rider icon in the top bar and then tap your rider.",
  "@faqRiderWeightAnswer": {
    "description": "Answer of the FAQ entry \"RiderWeight\"."
  },
  "faqStravaWhatQuestion": "What is Strava Sync?",
  "@faqStravaWhatQuestion": {
    "description": "Question of the FAQ entry \"StravaWhat\"."
  },
  "faqStravaWhatAnswer": "Strava Sync is a paid subscription that automatically imports your Strava activities into the app. New, updated, and deleted activities are synced in real time so you can see which setup you ran on every ride. You can also trigger a manual sync at any time — up to once per hour.",
  "@faqStravaWhatAnswer": {
    "description": "Answer of the FAQ entry \"StravaWhat\"."
  },
  "faqStravaCancelQuestion": "How do I cancel my subscription?",
  "@faqStravaCancelQuestion": {
    "description": "Question of the FAQ entry \"StravaCancel\"."
  },
  "faqStravaCancelAnswer": "You can cancel at any time directly through the App Store or Google Play — not through the app itself.\n\nOn iPhone: Settings → [your name] → Subscriptions → Bike Setup Tracker → Cancel.\n\nOn Android: Google Play → Profile icon → Payments & subscriptions → Subscriptions → Bike Setup Tracker → Cancel.\n\nYour access remains active until the end of the current billing period.",
  "@faqStravaCancelAnswer": {
    "description": "Answer of the FAQ entry \"StravaCancel\"."
  },
  "faqStravaRefundQuestion": "How do I request a refund?",
  "@faqStravaRefundQuestion": {
    "description": "Question of the FAQ entry \"StravaRefund\"."
  },
  "faqStravaRefundAnswer": "Refunds are handled by Apple or Google, not by us.\n\nOn iPhone: Visit reportaproblem.apple.com, find the charge, and request a refund.\n\nOn Android: Open Google Play → Profile icon → Payments & subscriptions → Subscriptions or Order history → tap the purchase → Request a refund.",
  "@faqStravaRefundAnswer": {
    "description": "Answer of the FAQ entry \"StravaRefund\"."
  },
  "faqStravaRestoreQuestion": "How do I restore a previous subscription?",
  "@faqStravaRestoreQuestion": {
    "description": "Question of the FAQ entry \"StravaRestore\"."
  },
  "faqStravaRestoreAnswer": "Open the Strava Sync sheet (tap the Strava icon in the top bar) and tap \"Restore previous purchase.\" The app will contact the store and restore your active subscription automatically.",
  "@faqStravaRestoreAnswer": {
    "description": "Answer of the FAQ entry \"StravaRestore\"."
  },
  "faqStravaPaywallQuestion": "I resubscribed but the app still shows the paywall. What do I do?",
  "@faqStravaPaywallQuestion": {
    "description": "Question of the FAQ entry \"StravaPaywall\"."
  },
  "faqStravaPaywallAnswer": "Tap \"Restore previous purchase\" on the paywall screen. The app will check your current subscription status with the store and unlock access.",
  "@faqStravaPaywallAnswer": {
    "description": "Answer of the FAQ entry \"StravaPaywall\"."
  },
  "faqStravaExpireQuestion": "What happens to my data when my subscription expires?",
  "@faqStravaExpireQuestion": {
    "description": "Question of the FAQ entry \"StravaExpire\"."
  },
  "faqStravaExpireAnswer": "Your synced activities are removed from the app to respect your privacy. Your bike and component configurations are unaffected. If you resubscribe and reconnect Strava, a fresh sync will restore your activity history.",
  "@faqStravaExpireAnswer": {
    "description": "Answer of the FAQ entry \"StravaExpire\"."
  },
  "faqTasksWhatQuestion": "What is a Task?",
  "@faqTasksWhatQuestion": {
    "description": "Question of the FAQ entry \"TasksWhat\"."
  },
  "faqTasksWhatAnswer": "A Task is a piece of maintenance or an action you want to track for your bike or a specific component.",
  "@faqTasksWhatAnswer": {
    "description": "Answer of the FAQ entry \"TasksWhat\"."
  },
  "faqTasksRuleQuestion": "What is a \"Task Rule\"?",
  "@faqTasksRuleQuestion": {
    "description": "Question of the FAQ entry \"TasksRule\"."
  },
  "faqTasksRuleAnswer": "Think of a Task Rule as a \"Plan\" or \"Template.\" It defines what needs to happen (e.g., \"Bleed Brakes\"), its priority, and which bike or component it applies to. It sets the foundation for tracking when something should be done.",
  "@faqTasksRuleAnswer": {
    "description": "Answer of the FAQ entry \"TasksRule\"."
  },
  "faqTasksEntryQuestion": "What is a \"Task Entry\"?",
  "@faqTasksEntryQuestion": {
    "description": "Question of the FAQ entry \"TasksEntry\"."
  },
  "faqTasksEntryAnswer": "A Task Entry is a \"Log\" or \"Record\" of work actually performed. When you complete a task defined by a Task Rule, you create a Task Entry to save exactly when it happened and any notes you want to keep.",
  "@faqTasksEntryAnswer": {
    "description": "Answer of the FAQ entry \"TasksEntry\"."
  },
  "faqTasksTogetherQuestion": "How do they work together?",
  "@faqTasksTogetherQuestion": {
    "description": "Question of the FAQ entry \"TasksTogether\"."
  },
  "faqTasksTogetherAnswer": "The Task Rule defines the goal, and Task Entries track your history. Every time you finish a task, a new Entry is added to that Rule. This allows the app to show you a complete timeline of when the task was performed in the past.",
  "@faqTasksTogetherAnswer": {
    "description": "Answer of the FAQ entry \"TasksTogether\"."
  },
  "faqTasksDueOverdueQuestion": "What is the difference between \"Due\" and \"Overdue\"?",
  "@faqTasksDueOverdueQuestion": {
    "description": "Question of the FAQ entry \"TasksDueOverdue\"."
  },
  "faqTasksDueOverdueAnswer": "Both statuses mean the task needs your attention, but at different urgency levels.\n\n\"Due\" (shown in orange) means the task has reached 100% of its interval — it's time to do it.\n\n\"Overdue\" (shown in red) means the task has exceeded the interval by more than 10%. There is a small grace window before a task escalates from Due to Overdue, so a minor overshoot will not immediately turn red.",
  "@faqTasksDueOverdueAnswer": {
    "description": "Answer of the FAQ entry \"TasksDueOverdue\"."
  },
